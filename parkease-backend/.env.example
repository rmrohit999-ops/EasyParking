# ==============================================================================
# ParkEase backend — environment variable specification (Milestone 0 §14)
# Copy to .env.local for local dev (docker-compose values already match below).
# NEVER commit a file with real values. Secrets are injected by the deploy
# pipeline / secret manager in staging and production.
# ==============================================================================

# ---- Core / App --------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8081
LOG_LEVEL=debug
CORRELATION_ID_HEADER=x-correlation-id
# Milestone 12: unset = on outside production, off in production. Set to
# "true"/"false" to override either way. See configuration.ts.
ENABLE_API_DOCS=

# ---- Database / Cache ---------------------------------------------------------
DATABASE_URL=postgresql://parkease:parkease@localhost:5432/parkease?schema=public
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# ---- Auth / Sessions (Milestone 2 wires these up; declared now so config
#      validation is already in place) ------------------------------------------
JWT_ACCESS_SECRET=dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=dev-only-change-me-too
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_HASH_ALGO=argon2id
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- OTP / SMS (unset in dev -> OTP login is reported unavailable, never faked)
# Set SMS_PROVIDER=twilio and all three TWILIO_* fields below to enable it.
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ---- Email ----------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@parkease.app

# ---- Payments (unset in dev -> payment endpoints report unavailable) -------
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_ENV=test

# ---- Maps / Location --------------------------------------------------------
MAPS_API_KEY_SERVER=

# ---- Push / Notifications ---------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ---- Storage (MinIO locally, S3-compatible in staging/prod) ----------------
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET_PUBLIC=parkease-public
STORAGE_BUCKET_PRIVATE=parkease-private
STORAGE_ACCESS_KEY_ID=parkease
STORAGE_SECRET_ACCESS_KEY=parkease123
STORAGE_REGION=us-east-1
STORAGE_SIGNED_URL_TTL_SECONDS=600

# ---- Observability -----------------------------------------------------------
SENTRY_DSN_BACKEND=

# ---- QR pass signing (Milestone 8) ------------------------------------------
QR_SIGNING_SECRET=dev-only-change-me-qr

# ---- Business / feature config (non-secret, environment-scoped) ------------
DEFAULT_COMMISSION_PERCENT=10
DEFAULT_GST_PERCENT=18
BOOKING_HOLD_TTL_SECONDS=600
INSTANT_PARKING_OWNER_RESPONSE_TIMEOUT_SECONDS=90
INSTANT_MINIMUM_CHARGE_HOURS=1
CANCELLATION_FULL_REFUND_HOURS_BEFORE_START=2
CANCELLATION_PARTIAL_REFUND_PERCENT=50
INSTANT_CANCELLATION_GRACE_SECONDS=120
SUPPORT_CONTACT_EMAIL=support@parkease.app
SUPPORT_CONTACT_PHONE=
PRIVACY_POLICY_URL=https://claude.ai/code/artifact/f5ce0140-a291-4052-a126-482dee0b6246
TERMS_URL=https://claude.ai/code/artifact/f5ce0140-a291-4052-a126-482dee0b6246

# ---- Payout encryption (Milestone 9) — AES-256-GCM key (32 raw bytes,
#      base64-encoded) protecting owner bank/UPI details at rest. Unset in
#      dev -> payout-account creation reports unavailable. Generate with:
#      `openssl rand -base64 32`
PAYOUT_ENCRYPTION_KEY=

# ---- Settlements / payouts (Milestone 9, unset -> settlement processing
#      reports unavailable, never faked) ---------------------------------
PAYOUT_PROVIDER=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
