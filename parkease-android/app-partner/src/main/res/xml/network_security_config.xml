<?xml version="1.0" encoding="utf-8"?>
<!-- Production/staging: HTTPS only, no cleartext, no user-added CAs trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
