<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet is a normal permission (no runtime prompt). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Runtime-requested permissions (Milestone 0 §15 Android Permission
        Plan). Declared here per manifest convention but NOT requested at
        install time — each is requested just-in-time, with rationale, at
        the point of use in its owning feature module:
          - ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION: Find Parking /
            Instant Parking / navigation (feature/driver-search, Milestone 5).
          - CAMERA: QR scanning and listing/entrance photo capture
            (feature/attendant-qr-scan Milestone 8, owner photo upload
            Milestone 4).
          - POST_NOTIFICATIONS (API 33+): first booking confirmation
            (Milestone 11).
        Deliberately NOT requested anywhere in this app, because no
        implemented feature justifies them: ACCESS_BACKGROUND_LOCATION,
        READ_SMS / RECEIVE_SMS (OTP is entered manually, never auto-read).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".ParkEaseApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParkEase">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ParkEase">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Milestone 11: real FCM HTTP v1 push, client side. Declaring this
            service is what lets FirebaseMessagingService#onNewToken /
            #onMessageReceived actually fire — see ParkEaseMessagingService's
            doc comment for what each does.
        -->
        <service
            android:name=".notifications.ParkEaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default channel/icon for a notification-payload FCM message the OS auto-displays without invoking onMessageReceived (app killed, not just backgrounded). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="parkease_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!--
            Lets the in-app camera capture (owner photo upload) hand the
            system Camera app a writable content:// URI for its temp file —
            required since Android 7 blocks file:// URIs shared across app
            boundaries. ${applicationId} resolves per build flavor
            (com.parkease.app / .dev / .staging), so this never collides
            across the three variants installed side by side.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
