# Same ParkEase backend every mobile app talks to.
API_BASE_URL=https://easyparking-production.up.railway.app

# Keeps Server Action references decryptable across restarts/redeploys —
# without a stable value, a client mid-action during a redeploy sees
# "Failed to find Server Action". Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
